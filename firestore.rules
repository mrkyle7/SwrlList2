rules_version = '2';

// Security rules for the Swrl List Firestore database (project swrl-1118).
//
// NOT deployed by CI: review against the rules in the Firebase console and
// apply by hand. See docs/friends-and-visibility-plan.md ("Rollout").
//
// The app signs everyone in, anonymously when they have not logged in with
// Google, so "signed in" below includes anonymous users. Rules that must
// work for people who are not signed in at all say so.
//
// Every collection the app uses has a block here; anything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // True when `uid` has accepted `viewer` as a friend. The friends docs are
    // written only by Cloud Functions, so this cannot be forged.
    function isFriendOf(uid, viewer) {
      return exists(/databases/$(database)/documents/swrlers/$(uid)/friends/$(viewer));
    }

    function isVisibility(value) {
      return value in ['private', 'friends', 'public'];
    }

    // ---------------------------------------------------------------------
    // swrls/{id}: the shared doc for an item. Details and anonymous counts
    // only; who has it lives in swrlers/{uid}/listEntries.
    // Anyone may read it (deep links work before sign-in has finished).
    // Signed-in users may write details, but never the counts (Cloud
    // Functions keep those) nor the legacy uid arrays (they exposed who has
    // what; old clients that still write them are refused). No client deletes.
    // ---------------------------------------------------------------------
    match /swrls/{swrlID} {
      allow read: if true;
      allow create: if isSignedIn()
        && !request.resource.data.keys().hasAny(
          ['laterCount', 'doneCount', 'lovedCount', 'later', 'done', 'deleted', 'loved', 'isRecommended']);
      allow update: if isSignedIn()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
          ['laterCount', 'doneCount', 'lovedCount', 'later', 'done', 'deleted', 'loved', 'isRecommended']);
    }

    // ---------------------------------------------------------------------
    // swrlers/{uid}: the public profile (name, photo, default visibility).
    // Read by any signed-in user. That includes anonymous users, who need it
    // for deep links (/swrler/:id, the full page's recommender and Swrlers
    // cards); the app always signs visitors in anonymously first, so there
    // is no need to open it to unauthenticated requests. Written only by
    // the owner, never with an email, and never deleted from a client.
    // ---------------------------------------------------------------------
    match /swrlers/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid)
        && !request.resource.data.keys().hasAny(['email'])
        && (!('uid' in request.resource.data) || request.resource.data.uid == uid)
        && (!('defaultVisibility' in request.resource.data)
            || isVisibility(request.resource.data.defaultVisibility));

      // One user's state for one swrl. The owner has full access (the data
      // must say whose it is and what it is). Everyone else reads by the
      // entry's visibility; a query must carry a matching constraint, e.g.
      // visibility == 'public' or visibility in ['public', 'friends'].
      match /listEntries/{swrlID} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.swrlID == swrlID
          && isVisibility(request.resource.data.visibility);
        allow delete: if isOwner(uid);

        allow read: if resource.data.visibility == 'public';
        allow read: if isSignedIn()
          && resource.data.visibility == 'friends'
          && isFriendOf(uid, request.auth.uid);
      }

      // Accepted friends, mirrored on both sides. Created only by Cloud
      // Functions (when a request is accepted); the owner may read the list
      // and delete a friend (a function removes the other side).
      match /friends/{friendUid} {
        allow read, delete: if isOwner(uid);
      }

      // Private notes, readable and writable by the owner only.
      match /privateComments/{swrlID}/comments/{commentID} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
                      && request.resource.data.keys().hasOnly(['text', 'created'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000;
        allow update: if request.auth != null && request.auth.uid == uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000;
      }
    }

    // ---------------------------------------------------------------------
    // Collection group query on every listEntries collection: the full
    // page's "Swrlers" card asks for swrlID == x and visibility == 'public'.
    // Only public entries are readable this way, by anyone (even unsigned).
    // ---------------------------------------------------------------------
    match /{path=**}/listEntries/{swrlID} {
      allow read: if resource.data.visibility == 'public';
    }

    // ---------------------------------------------------------------------
    // friendRequests/{from}_{to}: created by the sender as pending, seen by
    // both sides. Only the receiver may accept (a Cloud Function then writes
    // the friends docs and deletes the request); either side may delete it
    // (cancel or decline).
    // ---------------------------------------------------------------------
    match /friendRequests/{requestID} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow create: if isOwner(request.resource.data.from)
        && request.resource.data.keys().hasOnly(['from', 'to', 'created', 'status'])
        && request.resource.data.to is string
        && request.resource.data.from != request.resource.data.to
        && requestID == request.resource.data.from + '_' + request.resource.data.to
        && request.resource.data.status == 'pending'
        && request.resource.data.created == request.time
        && !isFriendOf(request.resource.data.from, request.resource.data.to);
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.to
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
      allow delete: if isSignedIn()
        && (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
    }

    // ---------------------------------------------------------------------
    // recommendations: from one user to a list of others. Read only by the
    // sender and the receivers (the app's two listeners query by `from` and
    // by `to array-contains`, which these rules allow). A receiver may only
    // add or remove their own uid in `read` / `dismissed`. No client deletes.
    // ---------------------------------------------------------------------
    match /recommendations/{recommendationID} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.from || request.auth.uid in resource.data.to);
      allow create: if isOwner(request.resource.data.from)
        && request.resource.data.keys().hasOnly(['from', 'to', 'message', 'swrlID', 'created'])
        && request.resource.data.to is list
        && request.resource.data.to.size() > 0;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.to
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'dismissed'])
        && request.resource.data.get('read', []).hasOnly(
          resource.data.get('read', []).concat([request.auth.uid]))
        && request.resource.data.get('dismissed', []).hasOnly(
          resource.data.get('dismissed', []).concat([request.auth.uid]));
    }

    // ---------------------------------------------------------------------
    // messagingtokens/{token}: a device's push token and its owner's uid.
    // The client writes it (doc id = token) when a user signs in on a device,
    // so a device handed to another user takes the doc over; only the
    // current owner may read or delete it. Cloud Functions read it as admin.
    // ---------------------------------------------------------------------
    match /messagingtokens/{token} {
      allow read, delete: if isSignedIn() && request.auth.uid == resource.data.uid;
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasOnly(['uid', 'token'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.token == token;
    }

    // ---------------------------------------------------------------------
    // savedsearches/{id}: a user's saved discover searches; owner only. The
    // app queries with where('uid', '==', me), which these rules allow.
    // ---------------------------------------------------------------------
    match /savedsearches/{searchID} {
      allow read, delete: if isSignedIn() && request.auth.uid == resource.data.uid;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.uid
        && request.resource.data.uid == request.auth.uid;
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
